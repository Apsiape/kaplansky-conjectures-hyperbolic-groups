== Lemma 2.1 in Z[B] (universal: holds in every ring with ab = 1) ==
   e = ba = 1*b^1a^1;   n = b(1-e) = 1*b^1a^0 + -1*b^2a^1
   ab = 1                       True
   ba != 1 (in B)               True
   e^2 = e                      True
   e(1-e) = 0                   True
   (1-e)e = 0                   True
   (1-e)b = 0                   True
   n^2 = 0                      True
   (1+n)(1-n) = 1               True
   (1-n)(1+n) = 1               True
   a n = 1 - e                  True
   a e b = 1                    True
   e != 0 (illustrative)        True
   e != 1 (illustrative)        True
   n != 0 (illustrative)        True
